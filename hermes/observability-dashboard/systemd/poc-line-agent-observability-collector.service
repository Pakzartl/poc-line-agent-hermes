[Unit]
Description=Collect bounded OVH observability snapshot
After=docker.service cloudflared.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/usr/bin/python3 /srv/hermes/app/observability-dashboard/collector.py
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/srv/hermes/observability
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
