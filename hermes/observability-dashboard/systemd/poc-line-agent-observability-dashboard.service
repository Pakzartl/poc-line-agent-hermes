[Unit]
Description=Read-only Javis OVH observability dashboard
After=network-online.target poc-line-agent-observability-collector.service
Wants=network-online.target

[Service]
Type=simple
User=observability
Group=observability
EnvironmentFile=/srv/hermes/observability/dashboard.env
Environment=OBSERVABILITY_SNAPSHOT_PATH=/srv/hermes/observability/snapshot.json
Environment=OBSERVABILITY_ASSETS_DIR=/srv/hermes/app/observability-dashboard
Environment=OBSERVABILITY_DASHBOARD_PORT=8791
ExecStart=/usr/local/bin/bun /srv/hermes/app/observability-dashboard/server.ts
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/hermes/app/observability-dashboard /srv/hermes/observability
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
TasksMax=64
MemoryMax=128M

[Install]
WantedBy=multi-user.target
