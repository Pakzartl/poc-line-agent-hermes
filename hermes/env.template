# Copy to hermes/env.local on the host. Do not commit real values.

# Hermes API server. The Worker will use the same value as HERMES_API_SERVER_KEY.
API_SERVER_KEY=replace-with-32-byte-random-secret
API_SERVER_CORS_ORIGINS=

# Model provider credentials owned by the Hermes runtime in hermes mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Read-only GitHub plugin credentials. Repository and branch come from each user request.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# Discord Gateway bridge. The bridge runs on the OVH host and forwards normal
# Discord messages to the Worker gateway endpoint with an HMAC signature.
DISCORD_BOT_TOKEN=
DISCORD_WORKER_GATEWAY_URL=https://agent.pakzartl.xyz/discord/gateway/messages
DISCORD_GATEWAY_SHARED_SECRET=replace-with-32-byte-random-secret
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_API_BASE_URL=https://discord.com/api/v10

# Local-only capability adapter. The same token is configured on the Worker as
# ARTIFACT_RENDERER_TOKEN. Targets are server-owned; Discord users send only ids.
CAPABILITY_ADAPTER_TOKEN=replace-with-32-byte-random-secret
CAPABILITY_ARTIFACT_TARGETS_JSON=[{"id":"javis-health","url":"https://agent.pakzartl.xyz/health"}]

# Optional read-only DB adapter. Leave unset unless a read-only PostgreSQL
# datasource exists. The Worker uses DATABASE_ADAPTER_URL and DATABASE_ADAPTER_TOKEN.
DB_ADAPTER_TOKEN=replace-with-32-byte-random-secret
DB_ADAPTER_DATASOURCES_JSON=[{"alias":"lms-readonly","connectionStringEnv":"LMS_READONLY_DATABASE_URL"}]
DB_ADAPTER_MAX_ROWS=100
DB_ADAPTER_MAX_BYTES=250000
DB_ADAPTER_TIMEOUT_MS=5000
LMS_READONLY_DATABASE_URL=

# Approval-gated deploy executor. Runs as a loopback-only systemd service on
# the OVH host; the Worker reaches it through the existing Cloudflare Tunnel.
DEPLOY_EXECUTOR_TOKEN=replace-with-32-byte-random-secret
DEPLOY_EXECUTOR_PORT=8790
DEPLOY_EXECUTOR_STATE_DIR=/srv/hermes/deploy-executor
DEPLOY_EXECUTOR_TARGETS_JSON=[{"id":"hermes-ovh","repository":"Pakzartl/poc-line-agent-hermes","appDir":"/srv/hermes/app","backupDir":"/srv/hermes/backups","composeFile":"hermes/compose.yaml","healthcheckUrl":"https://hermes.pakzartl.xyz/health"}]

# Optional dashboard. Leave disabled until an auth provider is configured.
HERMES_DASHBOARD=0
