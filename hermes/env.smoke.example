# Test-only values for local boot/health smoke checks.
# Copy to hermes/env.smoke only for local smoke; do not use for real traffic.

API_SERVER_KEY=local-smoke-api-key-0000000000000000
API_SERVER_CORS_ORIGINS=

# Placeholder model credentials for the compose.fake-openai.yaml local service.
# These values must never be used for real traffic or external LLM calls.
OPENAI_API_KEY=local-fake-openai-key
OPENAI_BASE_URL=http://fake-openai:8080/v1
OPENAI_MODEL=fake-hermes-model

# Placeholder GitHub plugin credentials. Do not call GitHub tools with these values.
GITHUB_TOKEN=local-smoke-placeholder
GITHUB_API_BASE_URL=https://api.github.com

HERMES_DASHBOARD=0
