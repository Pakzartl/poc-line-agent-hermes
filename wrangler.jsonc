{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "poc-line-agent",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "agent.pakzartl.xyz",
			"custom_domain": true
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.md"],
			"fallthrough": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION_MEMORY",
			"id": "4de15238ac864a47ad3fa63b9a751671"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "TELEGRAM_SESSION_COORDINATOR",
				"class_name": "TelegramSessionCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TelegramSessionCoordinator"]
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "TELEGRAM_JOBS",
				"queue": "poc-line-agent-telegram-jobs"
			}
		],
		"consumers": [
			{
				"queue": "poc-line-agent-telegram-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 2,
				"dead_letter_queue": "poc-line-agent-telegram-jobs-dlq",
				"max_concurrency": 1
			},
			{
				"queue": "poc-line-agent-telegram-jobs-dlq",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 2,
				"max_concurrency": 1
			}
		]
	},
	"secrets": {
		"required": [
			"LINE_CHANNEL_SECRET",
			"LINE_CHANNEL_ACCESS_TOKEN",
			"TELEGRAM_BOT_TOKEN",
			"TELEGRAM_WEBHOOK_SECRET",
			"TELEGRAM_ALLOWED_USER_IDS",
			"DISCORD_ALLOWED_USER_IDS",
			"DISCORD_BOT_TOKEN",
			"DISCORD_GATEWAY_SHARED_SECRET",
			"DISCORD_ALLOWED_GUILD_IDS",
			"OPENAI_API_KEY",
			"GITHUB_TOKEN",
			"HERMES_API_SERVER_KEY",
			"INTENT_ROUTER_CF_ACCESS_CLIENT_ID",
			"INTENT_ROUTER_CF_ACCESS_CLIENT_SECRET"
		]
	},
	"vars": {
		"INTENT_ROUTER_ENABLED": "true",
		"INTENT_ROUTER_PROTOCOL": "systemone",
		"INTENT_ROUTER_ENDPOINT_URL": "https://llm.codemonday.ai/base/v1/systemone",
		"INTENT_ROUTER_TIMEOUT_MS": "45000",
		"INTENT_ROUTER_MIN_PROBABILITY": "0.75",
		"INTENT_ROUTER_MIN_MARGIN": "0.20",
		"AGENT_RUNTIME": "hermes",
		"LINE_API_BASE_URL": "https://api.line.me",
		"TELEGRAM_API_BASE_URL": "https://api.telegram.org",
		"DISCORD_APPLICATION_ID": "1556207639229112360",
		"DISCORD_PUBLIC_KEY": "e3814a07ad03178f24fe93b1aacc9b1cef679107658622f8a15c7679a5f0e339",
		"DISCORD_API_BASE_URL": "https://discord.com/api/v10",
		"WHATSAPP_API_BASE_URL": "https://graph.facebook.com/v26.0",
		"WHATSAPP_ACCESS_TOKEN": "",
		"WHATSAPP_PHONE_NUMBER_ID": "",
		"WHATSAPP_VERIFY_TOKEN": "",
		"WHATSAPP_APP_SECRET": "",
		"OPENAI_BASE_URL": "https://api.openai.com/v1",
		"OPENAI_MODEL": "gpt-6-luna",
		"OPENAI_MAX_TOOL_ROUNDS": "50",
		"OPENAI_MAX_TOOL_CALLS": "100",
		"GITHUB_API_BASE_URL": "https://api.github.com",
		"GITHUB_REF": "dev",
		"SESSION_MEMORY_MAX_MESSAGES": "12",
		"HERMES_BASE_URL": "https://hermes.pakzartl.xyz",
		"HERMES_TELEGRAM_ALLOWED_USER_IDS": "",
		"QUEUE_FAILURE_DISCORD_CHANNEL_ID": "1556222756406956163",
		"DATABASE_ADAPTER_URL": "",
		"DATABASE_DATASOURCE": "",
		"DATABASE_ALLOWED_SCHEMAS": "",
		"DATABASE_ALLOWED_TABLES": "",
		"DATABASE_SCHEMA_CATALOG_JSON": "",
		"ARTIFACT_RENDERER_URL": "https://capabilities.pakzartl.xyz/artifact/render",
		"ARTIFACT_SCREENSHOT_TARGETS_JSON": "[{\"id\":\"javis-health\",\"url\":\"https://agent.pakzartl.xyz/health\"}]",
		"DEPLOY_TARGETS_JSON": "[{\"id\":\"hermes-ovh\",\"displayName\":\"Hermes OVH\",\"environment\":\"production\",\"allowedRepositories\":[\"Pakzartl/poc-line-agent-hermes\"],\"executorUrl\":\"https://deploy.pakzartl.xyz/deploy\",\"healthcheckUrl\":\"https://hermes.pakzartl.xyz/health\"}]"
	},
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	}
}
