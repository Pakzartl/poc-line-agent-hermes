# Runtime modes:
# - legacy: all providers use the Worker legacy agent.
# - hermes: all allowed Telegram agent traffic uses Hermes; configured LINE/WhatsApp stay legacy.
# - fallback: only HERMES_TELEGRAM_ALLOWED_USER_IDS use Hermes; all other traffic stays legacy.
AGENT_RUNTIME=legacy

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_API_BASE_URL=https://api.line.me

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org

DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_API_BASE_URL=https://discord.com/api/v10
# Used to register slash commands and to send natural-chat channel replies.
DISCORD_BOT_TOKEN=
# Shared only by the OVH Gateway bridge and the Worker; use at least 32 random characters.
DISCORD_GATEWAY_SHARED_SECRET=
# Used by the OVH Gateway bridge.
DISCORD_WORKER_GATEWAY_URL=https://agent.pakzartl.xyz/discord/gateway/messages
# Optional: registers commands immediately in one test server instead of globally.
DISCORD_GUILD_ID=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v26.0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_TOOL_ROUNDS=50
OPENAI_MAX_TOOL_CALLS=100

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REF=dev

SESSION_MEMORY_DIR=.sessions
SESSION_MEMORY_MAX_MESSAGES=12

HERMES_BASE_URL=
HERMES_API_SERVER_KEY=
# Used only by AGENT_RUNTIME=fallback for Telegram canary routing.
HERMES_TELEGRAM_ALLOWED_USER_IDS=

# Optional signed event ingestion for queue failure HIL artifacts.
QUEUE_FAILURE_EVENT_SECRET=
QUEUE_FAILURE_DISCORD_CHANNEL_ID=

# Optional capability adapters. Leave each complete block blank to keep it disabled.
# Example: https://db-capabilities.example.com/db/query
DATABASE_ADAPTER_URL=
DATABASE_ADAPTER_TOKEN=
DATABASE_DATASOURCE=
DATABASE_ALLOWED_SCHEMAS=
DATABASE_ALLOWED_TABLES=

ARTIFACT_RENDERER_URL=
ARTIFACT_RENDERER_TOKEN=
# JSON array: [{"id":"learner-preview","url":"https://learner.example"}]
ARTIFACT_SCREENSHOT_TARGETS_JSON=

# JSON array of allowlisted target objects; see README.md. Requires a separate executor token.
DEPLOY_TARGETS_JSON=
DEPLOY_EXECUTOR_TOKEN=

PORT=3000
